# ==============================================================================
# SMARTINVITE .gitignore
# Public Repository Rules: Strictly block secrets, user media, builds & backups
# ==============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Next.js Build & Outputs
.next/
out/
build/
dist/
.swc/
.turbo/
.vercel

# TypeScript Incremental Build Cache
*.tsbuildinfo
tsconfig.tsbuildinfo

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (CRITICAL: Public Repository Protection)
# ------------------------------------------------------------------------------
.env
.env.*
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.staging
.env.production

# Always keep example configuration template tracked
!.env.example
!.env*.example

# Private Keys, Certificates & Credentials
*.pem
*.key
*.crt
*.pfx
*.p12
*.keystore
id_rsa*
id_ed25519*
secrets/
credentials.json
serviceAccountKey*.json
token.json

# ------------------------------------------------------------------------------
# Database Backups & Data Dumps
# (Note: db/migrations/*.sql and db/init/* remain tracked)
# ------------------------------------------------------------------------------
backups/
*.dump
*.dump.gz
*.partial
*.bak
*.backup
backup*.sql
dump*.sql
*.sql.dump
*.sql.gz

# ------------------------------------------------------------------------------
# Uploads & User Generated Content (Media, QR codes, avatars - PII protection)
# ------------------------------------------------------------------------------
uploads/*
!uploads/.gitkeep
public/uploads/*
!public/uploads/.gitkeep

# Compressed Archives
*.tar
*.tar.gz
*.zip
*.7z
*.rar
*.gz

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test Coverage & Verification Artifacts
coverage/
.nyc_output/
playwright-report/
test-results/
artifacts/

# Temporary / Cache Files
.cache/
.temp/
.tmp/
tmp/

# Operating System Files
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# IDE & Editor Configurations
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
