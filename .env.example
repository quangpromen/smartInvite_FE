# Use real DNS name, without https:// and without trailing slash
DOMAIN=invite.example.com
# Change image for each release, e.g. smartinvite:20261016-01
APP_IMAGE=smartinvite:20261016-01
# Must be freshly generated hex strings (e.g. openssl rand -hex 24)
PG_SUPER_PASSWORD=REPLACE_WITH_48_OR_MORE_HEX_CHARACTERS
APP_DB_PASSWORD=REPLACE_WITH_ANOTHER_48_HEX_CHARACTERS
AUTH_SECRET=REPLACE_WITH_ANOTHER_64_HEX_CHARACTERS
